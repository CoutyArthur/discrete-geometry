IF(NOT EXISTS "C:/Users/couty25/Documents/geoDiscrete/build/_deps/dgtal-build/install_manifest.txt")
  MESSAGE(FATAL_ERROR "Cannot find install manifest: \"C:/Users/couty25/Documents/geoDiscrete/build/_deps/dgtal-build/install_manifest.txt\"")
ENDIF(NOT EXISTS "C:/Users/couty25/Documents/geoDiscrete/build/_deps/dgtal-build/install_manifest.txt")

FILE(READ "C:/Users/couty25/Documents/geoDiscrete/build/_deps/dgtal-build/install_manifest.txt" files)
STRING(REGEX REPLACE "\n" ";" files "${files}")
foreach(file ${files})
  MESSAGE(STATUS "Uninstalling \"$ENV{DESTDIR}${file}\"")
  IF(EXISTS "$ENV{DESTDIR}${file}")
    FILE(REMOVE ${file})
  ELSE(EXISTS "$ENV{DESTDIR}${file}")
    MESSAGE(STATUS "File \"$ENV{DESTDIR}${file}\" does not exist.")
  ENDIF(EXISTS "$ENV{DESTDIR}${file}")
endforeach()
